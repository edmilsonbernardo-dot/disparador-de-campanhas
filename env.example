# Copie este arquivo para ".env" e preencha os valores antes de rodar.

# Senha usada para entrar no painel (escolha algo forte).
ADMIN_PASSWORD=troque-esta-senha

# Chave secreta do Flask (qualquer texto aleatório longo).
SECRET_KEY=troque-esta-chave-secreta

# Usada para criptografar a senha de app do Gmail salva no banco.
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# URL pública onde a aplicação vai ficar hospedada (sem barra no final).
# É usada para montar o link do pixel de rastreamento dentro dos e-mails.
# Exemplo: https://meu-disparador.onrender.com
BASE_URL=http://localhost:5000

# Banco de dados. Por padrão usa SQLite em arquivo local.
DATABASE_URL=sqlite:///instance/app.db
